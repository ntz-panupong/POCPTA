managed implementation in class ZBP_I_QM_SPECT unique;
strict ( 2 );
with draft;

define behavior for ZI_QM_SPECT alias SpecHeader
persistent table zqmtspht
draft table zqmtsphdt
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
early numbering
{
  field ( readonly ) DocNo, Version, LocalCreatedBy, LocalCreatedAt, LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;
  field ( mandatory ) ProductCode, ProductName;

  create;
  update;
  delete;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation ValidateHeader;
    validation SpecItem~ValidateItem;
  }

  action ( features : instance ) NewVersion result [1] $self;
  action ( features : instance ) Copy result [1] $self;
  action ( features : instance ) Print result [1] $self;
  action ( features : instance ) AddSection parameter ZA_QM_SPEC_ADDSECT result [1] $self;

  validation ValidateHeader on save { create; update; field ProductCode, ProductName, ImageContent, ImageMimetype; }

  association _Item { create; with draft; }

  mapping for zqmtspht
  {
    DocNo              = doc_no;
    Version            = version;
    ProductCode        = product_code;
    ProductName        = product_name;
    LongText           = long_text;
    ImageFilename      = image_filename;
    ImageMimetype      = image_mimetype;
    ImageContent       = image_content;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

define behavior for ZI_QM_SPECITEMT alias SpecItem
persistent table zqmtspit
draft table zqmtspidt
lock dependent by _Header
authorization dependent by _Header
etag master LocalLastChangedAt
early numbering
{
  update;
  delete;

  field ( readonly ) DocNo, Version, SectionNo, LineNo, LocalLastChangedAt;
  field ( mandatory ) SectionTitle;

  action ( features : instance ) AddRow result [1] $self;
  action ( features : instance ) MoveUp result [1] $self;
  action ( features : instance ) MoveDown result [1] $self;

  validation ValidateItem on save { create; update; field SectionTitle; }

  association _Header { with draft; }

  mapping for zqmtspit
  {
    DocNo              = doc_no;
    Version            = version;
    SectionNo          = section_no;
    LineNo             = line_no;
    SectionTitle       = section_title;
    Col2Label          = col2_label;
    Col3Label          = col3_label;
    Topic              = topic;
    TopicBold          = topic_bold;
    TopicItalic        = topic_italic;
    Description        = description;
    DescBold           = desc_bold;
    DescItalic         = desc_italic;
    Method             = method;
    MethodBold         = method_bold;
    MethodItalic       = method_italic;
    LocalLastChangedAt = local_last_changed_at;
  }
}
