projection;
strict ( 2 );
use draft;

define behavior for ZC_QM_SPECT alias SpecHeader
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action NewVersion;
  use action Copy;
  use action Print;
  use action AddSection;

  use association _Item { create; with draft; }
}

define behavior for ZC_QM_SPECITEMT alias SpecItem
{
  use update;
  use delete;

  use action AddRow;
  use action MoveUp;
  use action MoveDown;

  use association _Header { with draft; }
}
